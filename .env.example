# =============================================================================
#  docker-compose settings for the API server · copy to .env · never commit .env
#  Application settings (database, mail, admin…) live in backend/.env.production.
# =============================================================================

# Public hostname of the API. Its DNS A record must point at this server;
# Caddy then obtains and renews the HTTPS certificate automatically.
API_DOMAIN=api.example.com

# "true" only for the very first start (creates roles + the first admin from
# ADMIN_EMAIL / ADMIN_PASSWORD). Set back to "false" afterwards.
RUN_SEED=false
