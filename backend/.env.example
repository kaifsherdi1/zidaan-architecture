# Local development. Copy to backend/.env, then: php artisan key:generate
# Production uses .env.production.example instead.

APP_NAME="Zidaan Architectures"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata

# The two Vite dev servers (used for links in emails)
FRONTEND_URL=http://localhost:5174
DASHBOARD_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (XAMPP/MariaDB/MySQL 8). For a zero-setup run you can instead use:
#   DB_CONNECTION=sqlite   (and delete the other DB_* lines; creates database/database.sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zidaan_architecture
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Emails are queued. Either run `php artisan queue:work` alongside the server,
# or set QUEUE_CONNECTION=sync to send them inline while developing.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes emails (incl. password-reset codes) to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_EXPIRATION=10080

# Empty = allow the local Vite servers on :5173 / :5174
CORS_ALLOWED_ORIGINS=

# Seeded admin (local defaults; production requires a strong value)
ADMIN_NAME="Studio Admin"
ADMIN_EMAIL=admin@zidaan.com
ADMIN_PASSWORD=Password@123

# Local: demo catalogue + demo logins on (Password@123)
SEED_DEMO_DATA=true
