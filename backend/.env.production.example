# =============================================================================
#  Zidaan Architectures API — PRODUCTION environment template
#  Copy to backend/.env.production on the server. Never commit the real file.
#  Every value marked REQUIRED must be filled in before the first start.
#  Full explanation of each setting: DEPLOYMENT.md → "Environment variables".
# =============================================================================

APP_NAME="Zidaan Architectures"
APP_ENV=production
# REQUIRED — generate once with: docker compose run --rm app php artisan key:generate --show
# Keep it forever: changing it invalidates encrypted data and signed links.
APP_KEY=
APP_DEBUG=false
# REQUIRED — public URL of this API (no trailing slash)
APP_URL=https://api.example.com

# REQUIRED — the two frontends. Used for CORS-adjacent links in emails.
FRONTEND_URL=https://www.example.com
DASHBOARD_URL=https://admin.example.com

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# Behind the Caddy TLS proxy: generate https:// links
FORCE_HTTPS=true

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ----- Database (REQUIRED) — MySQL 8 / MariaDB 10.6+ -----
# Use a dedicated user with rights on this database only (not root).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=zidaan
DB_USERNAME=zidaan_app
DB_PASSWORD=
# Managed MySQL that requires TLS (Aiven, RDS, …): put its CA certificate in
# backend/certs/ (git-ignored, mounted read-only) and point to it here.
# MYSQL_ATTR_SSL_CA=/var/www/html/storage/certs/ca.pem

# ----- Cache / sessions / queue — Redis runs inside docker-compose -----
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Emails are queued; the `queue` container delivers them (and retries 3x).
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ----- API tokens: lifetime in minutes (10080 = 7 days) -----
SANCTUM_EXPIRATION=10080

# ----- CORS (REQUIRED) — exact origins of the two frontends, comma separated -----
CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com

# ----- Mail (REQUIRED for password-reset codes and booking emails) -----
# Any SMTP provider works (Resend, Postmark, Amazon SES, Zoho, Google Workspace…).
# The FROM domain must be verified with the provider (SPF/DKIM) or mail lands in spam.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----- File storage — uploaded photos live in the `storage_data` docker volume -----
FILESYSTEM_DISK=public

# ----- First administrator (REQUIRED for the first seed) -----
# Created once by `RUN_SEED=true`; its password is never overwritten afterwards.
# Production refuses to seed without a strong password (12+ chars, mixed case,
# number, symbol). Change it after first login and delete it from this file.
ADMIN_NAME="Studio Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----- Demo data — keep FALSE for a real business -----
# true seeds 48 sample listings, sample agents and the weak-password demo logins
# (manager@zidaan.com / test@example.com, password Password@123). Only for demos.
SEED_DEMO_DATA=false

# ----- API docs: Swagger UI stays locked outside local -----
L5_SWAGGER_GENERATE_ALWAYS=false
