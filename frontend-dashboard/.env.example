# Copy to .env.local for development, or set these in your host's build settings.
# Values are baked in at build time (Vite) — rebuild after changing them.

# Base URL of the Laravel API, including /api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Public website — used for agents' "view listing" links
VITE_PUBLIC_SITE_URL=http://localhost:5174

# true = show click-to-fill demo logins on the sign-in page. NEVER for a real client deployment.
VITE_SHOW_DEMO_CREDENTIALS=false
